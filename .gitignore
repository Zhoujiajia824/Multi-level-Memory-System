# EP-Driver发布白名单：未列出的根目录文件仅保留本地。
/*
!/.gitignore
!/.gitattributes
!/LICENSE
!/README.md
!/environment.yml
!/pyproject.toml
!/requirements.txt
!/config/
!/scripts/
!/src/
!/models/

# 运行配置与安全模板；个人模型地址、密钥配置不上传。
/config/*
!/config/parameters.json
!/config/prompts.yaml
!/config/scenarios.yaml
!/config/verified_dependencies.txt
!/config/models.example.yaml
!/config/navsim.example.json
!/config/navsim/
/config/navsim/*
!/config/navsim/official_v2_2.json
!/config/navsim/sdk-requirements.txt
/config/navsim.local.json
/config/models.yaml

# 只发布环境检查、实验入口和记忆管理，不上传验收/临时脚本。
/scripts/*
!/scripts/check_environment.py
!/scripts/check_frenet_apf.py
!/scripts/check_planner_lane_potential.py
!/scripts/check_potential_domain_frame.py
!/scripts/check_dense_line_constraints.py
!/scripts/plot_lane_potential.py
!/scripts/check_highway_model_camera.py
!/scripts/check_model_object_scope.py
!/scripts/check_lane_object_scope.py
!/scripts/check_lane_body_intrusion.py
!/scripts/check_highway_truth_scope.py
!/scripts/check_highway_navigation_connectors.py
!/scripts/check_navigation_connection_domain.py
!/scripts/check_roundabout_entry_regression.py
!/scripts/check_grid_storage.py
!/scripts/check_grid_memory_io.py
!/scripts/check_grid_vector_retrieval.py
!/scripts/run_highway.py
!/scripts/run_navsim.py
!/scripts/check_navsim_integration.py
!/scripts/check_navsim_score_replay.py
!/scripts/check_navsim_replay_render.py
!/scripts/check_navsim_replay_official.py
!/scripts/check_navsim_warmup_recovery.py
!/scripts/check_navsim_resume_storage.py
!/scripts/check_navsim_official_style.py
!/scripts/check_navsim_navigation_preflight.py
!/scripts/export_navsim_test_assets.py
!/scripts/prepare_navsim_runtime.py
!/scripts/sync_navsim_viewer.py
!/scripts/capture_highway.py
!/scripts/memory_admin.py

# 当前核心为单一Python包；新增包或资产需明确加入发布清单。
/src/*
!/src/nine_grid/
!/src/ep_driver_navsim/
/src/ep_driver_navsim/*
!/src/ep_driver_navsim/*.py
/src/nine_grid/*
!/src/nine_grid/*.py

# Standalone, read-only viewer shipped with the evaluation branch.
!/tools/
/tools/*
!/tools/ep_agent_viewer/

# 仅发布运行需要的DINOv2 Base，权重由Git LFS管理。
/models/*
!/models/dinov2-base/
/models/dinov2-base/*
!/models/dinov2-base/config.json
!/models/dinov2-base/preprocessor_config.json
!/models/dinov2-base/model.safetensors
!/models/dinov2-base/LICENSE
!/models/dinov2-base/NOTICE
!/models/dinov2-base/provenance.json

# 以下文件不删除，只在本地保存。
/tests/
/docs/
!/docs/
/docs/*
!/docs/eight_grid_storage.md
/outputs/
/data/
/.cache/
/huggingface/
/logs/
.env
.env.*
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
*.log
*.tmp
*.bak
*.swp
.DS_Store
Thumbs.db

!/scripts/regression_model_perception_scope.py
