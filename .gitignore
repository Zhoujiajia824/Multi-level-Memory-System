# EP-Driver发布白名单：未列出的根目录文件仅保留本地。
/*
!/.gitignore
!/.gitattributes
!/LICENSE
!/README.md
!/environment.yml
!/pyproject.toml
!/requirements.txt
!/config/
!/scripts/
!/src/
!/models/

# 运行配置与安全模板；个人模型地址、密钥配置不上传。
/config/*
!/config/parameters.json
!/config/prompts.yaml
!/config/scenarios.yaml
!/config/verified_dependencies.txt
!/config/models.example.yaml
!/config/navsim.example.json
!/config/navsim/
/config/navsim/*
!/config/navsim/official_v2_2.json
!/config/navsim/sdk-requirements.txt
/config/navsim.local.json
/config/models.yaml

# 只发布正式运行、环境检查和数据工具，不上传回归/临时脚本。
/scripts/*
!/scripts/check_environment.py
!/scripts/plot_lane_potential.py
!/scripts/run_highway.py
!/scripts/run_navsim.py
!/scripts/export_navsim_test_assets.py
!/scripts/prepare_navsim_runtime.py
!/scripts/sync_navsim_viewer.py
!/scripts/capture_highway.py
!/scripts/memory_admin.py

# 当前核心为单一Python包；新增包或资产需明确加入发布清单。
/src/*
!/src/nine_grid/
!/src/ep_driver_navsim/
/src/ep_driver_navsim/*
!/src/ep_driver_navsim/*.py
/src/nine_grid/*
!/src/nine_grid/*.py

# Standalone, read-only viewer shipped with the evaluation branch.
!/tools/
/tools/*
!/tools/ep_agent_viewer/
/tools/ep_agent_viewer/tests/
/tools/ep_agent_viewer/.cache/

# 仅发布运行需要的DINOv2 Base，权重由Git LFS管理。
/models/*
!/models/dinov2-base/
/models/dinov2-base/*
!/models/dinov2-base/config.json
!/models/dinov2-base/preprocessor_config.json
!/models/dinov2-base/model.safetensors
!/models/dinov2-base/LICENSE
!/models/dinov2-base/NOTICE
!/models/dinov2-base/provenance.json

# 测试脚本与冒烟产物统一保留在本地，不发布。
/test/
/tests/
/docs/
!/docs/
/docs/*
!/docs/eight_grid_storage.md
/outputs/
/data/
/.cache/
/huggingface/
/logs/
.env
.env.*
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
*.log
*.tmp
*.bak
*.swp
.DS_Store
Thumbs.db
