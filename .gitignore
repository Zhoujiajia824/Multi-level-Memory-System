# EP-Driver发布白名单：未列出的根目录文件仅保留本地。
/*
!/.gitignore
!/.gitattributes
!/LICENSE
!/README.md
!/environment.yml
!/pyproject.toml
!/requirements.txt
!/config/
!/scripts/
!/src/
!/models/

# 运行配置与安全模板；个人模型地址、密钥配置不上传。
/config/*
!/config/parameters.json
!/config/prompts.yaml
!/config/scenarios.yaml
!/config/carla.yaml
!/config/carla_scenarios/
/config/carla_scenarios/*
!/config/carla_scenarios/*.yaml
!/config/carla_routes/
/config/carla_routes/*
!/config/carla_routes/*.json
!/config/verified_dependencies.txt
!/config/models.example.yaml
/config/models.yaml

# 发布运行入口、记忆管理及下列CARLA场景检查和验收工具；其余临时脚本仅留本地。
/scripts/*
!/scripts/check_environment.py
!/scripts/check_frenet_apf.py
!/scripts/check_planner_lane_potential.py
!/scripts/plot_lane_potential.py
!/scripts/check_carla_camera_clock.py
!/scripts/check_carla_camera_alignment.py
!/scripts/check_carla_camera_clock_metadata.py
!/scripts/check_carla_world_ownership.py
!/scripts/check_carla_object_categories.py
!/scripts/check_highway_model_camera.py
!/scripts/check_model_object_scope.py
!/scripts/check_lane_object_scope.py
!/scripts/check_highway_truth_scope.py
!/scripts/check_grid_storage.py
!/scripts/check_grid_memory_io.py
!/scripts/check_grid_vector_retrieval.py
!/scripts/run_highway.py
!/scripts/run_carla.py
!/scripts/memory_admin.py
!/scripts/check_carla_runtime_contract.py
!/scripts/check_carla_adapter_contract.py
!/scripts/check_carla_bridge_integration.py
!/scripts/check_carla_experiment_engine.py
!/scripts/check_carla_evaluation.py
!/scripts/check_carla_public_priority.py
!/scripts/check_carla_task_criteria.py
!/scripts/verify_carla_catalogue.py
!/scripts/validate_carla_experiment_runs.py
!/scripts/compile_carla_route.py

# 当前核心为单一Python包；新增包或资产需明确加入发布清单。
/src/*
!/src/nine_grid/
/src/nine_grid/*
!/src/nine_grid/*.py

# 仅发布运行需要的DINOv2 Base，权重由Git LFS管理。
/models/*
!/models/dinov2-base/
/models/dinov2-base/*
!/models/dinov2-base/config.json
!/models/dinov2-base/preprocessor_config.json
!/models/dinov2-base/model.safetensors
!/models/dinov2-base/LICENSE
!/models/dinov2-base/NOTICE
!/models/dinov2-base/provenance.json

# 以下文件不删除，只在本地保存。
/tests/
/docs/
!/docs/
/docs/*
!/docs/carla_experiments.md
!/docs/eight_grid_storage.md
/outputs/
/data/
/.cache/
/huggingface/
/logs/
.env
.env.*
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
*.log
*.tmp
*.bak
*.swp
.DS_Store
Thumbs.db
